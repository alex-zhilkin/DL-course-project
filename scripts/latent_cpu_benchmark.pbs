#!/usr/bin/env bash
#PBS -N lss_cpu_bench
#PBS -q mendels_q
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export OMP_NUM_THREADS=16 MKL_NUM_THREADS=16 PYTHONUNBUFFERED=1
export XDG_CACHE_HOME="${TMPDIR:-/tmp}/lss-cache-${PBS_JOBID}"
export MPLCONFIGDIR="$XDG_CACHE_HOME/matplotlib"
exec >"notebooks/results/latent_matched_study/job_logs/${PBS_JOBID}.log" 2>&1
exec .venv/bin/python scripts/benchmark_latent_cpu_threads.py
