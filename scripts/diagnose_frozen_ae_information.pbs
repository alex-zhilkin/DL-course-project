#!/usr/bin/env bash
#PBS -N lss_ae_info
#PBS -q mendels_q
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l place=free:shared
#PBS -l walltime=12:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 PYTHONUNBUFFERED=1
mkdir -p notebooks/results/ae_information_audit/job_logs
exec >"notebooks/results/ae_information_audit/job_logs/${PBS_JOBID}.log" 2>&1
exec .venv/bin/python scripts/diagnose_frozen_ae_information.py \
  --checkpoint "${LSS_CHECKPOINT:?}" --limit-per-source 3 --steps 100 --random-starts 2 --seed 917
