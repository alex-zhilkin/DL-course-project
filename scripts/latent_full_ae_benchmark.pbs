#!/usr/bin/env bash
#PBS -N lss_full_cpu
#PBS -q mendels_q
#PBS -l select=1:ncpus=64:mem=64gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export PYTHONUNBUFFERED=1
export LSS_PROJECT_ROOT="$PWD"
export MPLCONFIGDIR="${TMPDIR:-/tmp}/lss-full-ae-${PBS_JOBID}"
mkdir -p notebooks/results/latent_full_ae_benchmark/job_logs
exec >"notebooks/results/latent_full_ae_benchmark/job_logs/${PBS_JOBID}.log" 2>&1
exec .venv/bin/python scripts/benchmark_latent_full_ae.py
